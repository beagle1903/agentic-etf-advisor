APP_ENV=development

# Model provider: ollama or openrouter
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_CHAT_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=

# Market-data safety and retry policy
MARKET_DATA_MAX_AGE_HOURS=120
MARKET_DATA_FUTURE_TOLERANCE_MINUTES=5
YAHOO_MAX_ATTEMPTS=3
YAHOO_RETRY_BACKOFF_SECONDS=0.25

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-etf-advisor

# Local Docker services
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=etf_source_documents
NEO4J_URI=neo4j://localhost:17687
NEO4J_AUTH=neo4j/local-dev-password
POSTGRES_USER=etf_advisor
POSTGRES_PASSWORD=local-dev-password
POSTGRES_DB=etf_advisor
