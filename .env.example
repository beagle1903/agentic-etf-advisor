APP_ENV=development

# Model provider: ollama or openrouter
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_CHAT_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-etf-advisor

# Local Docker services
CHROMA_HOST=localhost
CHROMA_PORT=8000
NEO4J_URI=neo4j://localhost:17687
NEO4J_AUTH=neo4j/local-dev-password
POSTGRES_USER=etf_advisor
POSTGRES_PASSWORD=local-dev-password
POSTGRES_DB=etf_advisor
